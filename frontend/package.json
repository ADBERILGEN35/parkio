{
  "name": "parkio-frontend",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @parkio/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "guardrails": "node ./scripts/architecture/check-architecture.mjs",
    "guardrails:test": "node ./scripts/architecture/guardrails.test.mjs",
    "guardrails:lint": "eslint scripts/architecture",
    "guardrails:wp04": "node ./scripts/architecture/check-wp04.mjs",
    "guardrails:wp05": "node ./scripts/architecture/check-wp05.mjs",
    "guardrails:wp06": "node ./scripts/architecture/check-wp06.mjs",
    "guardrails:wp07": "node ./scripts/architecture/check-wp07.mjs",
    "guardrails:backend": "node ./scripts/architecture/check-backend-scope.mjs",
    "bundle:measure": "node ./scripts/architecture/measure-bundle-size.mjs",
    "contracts:openapi": "node ./scripts/contracts/openapi-comparison.mjs",
    "contracts:openapi:lint": "eslint scripts/contracts",
    "contracts:openapi:test": "node --test ./scripts/contracts/*.test.mjs",
    "e2e": "pnpm --filter @parkio/web e2e",
    "e2e:ui": "pnpm --filter @parkio/web e2e:ui",
    "e2e:real": "pnpm --filter @parkio/web e2e:real",
    "mobile": "pnpm --filter @parkio/mobile start",
    "mobile:typecheck": "pnpm --filter @parkio/mobile typecheck",
    "mobile:lint": "pnpm --filter @parkio/mobile lint",
    "mobile:test": "pnpm --filter @parkio/mobile test",
    "mobile:doctor": "pnpm --filter @parkio/mobile run doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "//overrides": "Security CI (Trivy, HIGH/CRITICAL fixable) floors. Stay on the current major for each package. image-size 2 drops the synchronous API Metro 0.84.4 calls, so the floor is Metro 0.84.5, which vendors those parsers. See docs/operations/security-findings-2026-07-25.md.",
    "overrides": {
      "form-data": "4.0.6",
      "axios": "^1.20.0",
      "postcss": "^8.5.23",
      "js-yaml": "^4.3.2",
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@5": "^5.0.11",
      "browserslist": "^4.28.7",
      "joi": "^17.13.7",
      "nanoid@3": "3.3.18",
      "metro": "0.84.5",
      "metro-babel-transformer": "0.84.5",
      "metro-cache": "0.84.5",
      "metro-cache-key": "0.84.5",
      "metro-config": "0.84.5",
      "metro-core": "0.84.5",
      "metro-file-map": "0.84.5",
      "metro-minify-terser": "0.84.5",
      "metro-resolver": "0.84.5",
      "metro-runtime": "0.84.5",
      "metro-source-map": "0.84.5",
      "metro-symbolicate": "0.84.5",
      "metro-transform-plugins": "0.84.5",
      "metro-transform-worker": "0.84.5",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@expo/metro-runtime": "56.0.16",
      "@expo/dom-webview": "56.0.6"
    }
  }
}
