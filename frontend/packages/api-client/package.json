{
  "name": "@parkio/api-client",
  "version": "1.0.0-rc1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm typecheck:contracts",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.type-tests.json",
    "lint": "eslint src",
    "build": "pnpm typecheck",
    "test": "vitest run",
    "test:task08": "vitest run --retry=0 src/contract.task08.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@parkio/types": "workspace:*",
    "@parkio/validation": "workspace:*",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@parkio/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.1",
    "msw": "^2.7.0",
    "vitest": "^3.0.5"
  }
}
