# Production environment.
# Copy to `.env.production` (gitignored) for local production-config testing, or
# rely on the EAS `production` profile (eas.json) which injects these at build time.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://api.parkio.dev/api/v1
EXPO_PUBLIC_SMART_RETURN_ENABLED=false
# Set by the release job/operator to the exact source commit embedded in the artifact.
EXPO_PUBLIC_GIT_SHA=0000000000000000000000000000000000000000
EXPO_PUBLIC_BUILD_TIMESTAMP=1970-01-01T00:00:00Z
