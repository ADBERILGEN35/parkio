# Local development environment.
# Copy to `.env.local` (gitignored). Only EXPO_PUBLIC_* vars reach the client bundle.
#
# Android emulator reaches the host machine via 10.0.2.2 (not localhost).
# iOS simulator can use localhost. A physical device needs your LAN IP.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_SMART_RETURN_ENABLED=true
