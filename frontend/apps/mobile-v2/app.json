{
  "expo": {
    "name": "Parkio",
    "slug": "parkio-v2",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkio-v2",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.parkio.mobilev2",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "dev.parkio.mobilev2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0050CB"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withAndroidAllowBackupFalse.js",
      "./plugins/withAndroidCompatibility.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Parkio uses the camera to photograph the parking spot you are sharing.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Parkio needs photo access so you can choose a parking spot image.",
          "cameraPermission": "Parkio uses the camera to photograph the parking spot you are sharing.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Parkio shows parking spots near you. Location is used only while you use the app; no movement history is stored.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0050CB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FF",
          "dark": {
            "backgroundColor": "#0B1626"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
