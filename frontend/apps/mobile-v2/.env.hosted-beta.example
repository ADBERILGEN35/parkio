# Public hosted-beta profile for internal release APKs (no secrets).
# Prefer: pnpm android:release:hosted-beta  (loads eas.json + validates).
# Optional local override file (gitignored): .env.hosted-beta
EXPO_PUBLIC_APP_ENV=hosted-beta
EXPO_PUBLIC_API_BASE_URL=https://api.parkio.dev/api/v1
EXPO_PUBLIC_SMART_RETURN_ENABLED=true
