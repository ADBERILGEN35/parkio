# Copy to .env.local for local development. Expo inlines EXPO_PUBLIC_* at bundle time.
EXPO_PUBLIC_APP_ENV=development
# Gateway base URL INCLUDING the /api/v1 prefix.
# - iOS simulator / web: http://localhost:8080/api/v1
# - Android emulator:    http://10.0.2.2:8080/api/v1
# - Physical device:     http://<your-lan-ip>:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_SMART_RETURN_ENABLED=true
# Municipal facility discovery (MOBILE-MUNI-V2-01). Default off — set true only when
# exercising guarded municipal query foundations. Flag-off = no municipal API traffic.
EXPO_PUBLIC_MUNICIPAL_DISCOVERY_ENABLED=false
