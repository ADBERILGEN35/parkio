{
  "name": "@parkio/web",
  "version": "1.0.0-rc1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:wp04": "vitest run --retry=0 src/data src/providers/query-client.test.ts",
    "test:wp05": "vitest run --retry=0 src/data/parking src/data/mutation-options src/data/query-options/query-options.test.ts",
    "test:wp06": "vitest run --retry=0 src/data/query-options/query-options.test.ts src/providers/query-client.test.ts",
    "test:task08": "vitest run --retry=0 src/providers/query-restoration.task08.test.tsx",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "verify:bundle-env": "node scripts/verify-bundle-env.mjs",
    "smoke:image": "node scripts/smoke-image.mjs",
    "test:release-gates": "node --test scripts/validate-build-env.test.mjs scripts/verify-bundle-env.test.mjs scripts/smoke-image.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/material-symbols-outlined": "^5.2.5",
    "@hookform/resolvers": "^3.9.1",
    "@parkio/api-client": "workspace:*",
    "@parkio/geo": "workspace:*",
    "@parkio/types": "workspace:*",
    "@parkio/ui": "workspace:*",
    "@parkio/validation": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "i18next": "^24.2.3",
    "maplibre-gl": "^4.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.1",
    "react-i18next": "^15.4.1",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@parkio/config": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
