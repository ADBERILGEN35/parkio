{
  "name": "Parkio",
  "short_name": "Parkio",
  "description": "Community-powered parking intelligence for finding, sharing, verifying, and managing real-world parking availability.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8faf8",
  "theme_color": "#147c72",
  "icons": [
    {
      "src": "/icons/parkio-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/parkio-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/parkio-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/parkio-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/parkio-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
