# Parkio Azure constrained hosted-beta environment template.
# Copy to docker/.env.azure-hosted-beta, replace every REPLACE_ME value, and
# keep the real file out of Git. This file is shell-source compatible.

PARKIO_DEPLOYMENT_PROFILE=azure-hosted-beta

# Public, client-visible hosts and build configuration.
PARKIO_DOMAIN=api.parkio.dev
PARKIO_WEB_DOMAIN=app.parkio.dev
PARKIO_WEB_UPSTREAM=web:80
PARKIO_MEDIA_DOMAIN=media.parkio.dev
PARKIO_MEDIA_STORAGE_ENDPOINT=http://minio:9000
PARKIO_MEDIA_STORAGE_PUBLIC_ENDPOINT=https://media.parkio.dev
PARKIO_ACME_EMAIL="REPLACE_ME_ops_email"
PARKIO_MAX_UPLOAD_SIZE=25MB
PARKIO_MAP_CONNECT_SRC=https://api.maptiler.com
PARKIO_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,127.0.0.1/32
PARKIO_CORS_ALLOWED_ORIGINS=https://app.parkio.dev
PARKIO_CORS_ALLOW_CREDENTIALS=true
# Public SPA origin embedded in transactional email links (email verification,
# password reset). Must be https://$PARKIO_WEB_DOMAIN; preflight enforces it.
PARKIO_WEB_BASE_URL=https://app.parkio.dev
VITE_API_BASE_URL=https://api.parkio.dev/api/v1
VITE_APP_ENV=hosted-beta
VITE_WAITLIST_INTAKE_MODE=api
VITE_SMART_RETURN_ENABLED=true
# WEB-MUNI-01A: leave true on hosted-beta only; production/default remains false.
VITE_WEB_MUNICIPAL_DISCOVERY_ENABLED=false
# PROVIDER-ISTANBUL-01C: Smart Parking Assistant (build-time Vite). Default false.
# Setting true requires a web image rebuild (not a parking-service recreate).
VITE_SMART_PARKING_ASSISTANT_ENABLED=false
VITE_MAPTILER_KEY=
VITE_MAPTILER_STYLE=streets-v2
VITE_FRONTEND_ERROR_REPORTING=disabled
EXPO_PUBLIC_APP_ENV=hosted-beta
EXPO_PUBLIC_API_BASE_URL=https://api.parkio.dev/api/v1
EXPO_PUBLIC_SMART_RETURN_ENABLED=true

# Server-only authentication and gateway trust.
PARKIO_JWT_PRIVATE_KEY_PEM="REPLACE_ME_pkcs8_pem_with_newline_escapes"
PARKIO_JWT_KEY_ID=parkio-auth-rs256-azure-beta-1
PARKIO_JWT_ISSUER=parkio-auth
PARKIO_JWT_AUDIENCE=parkio-api
PARKIO_JWT_CLOCK_SKEW_SECONDS=30
PARKIO_JWT_ADDITIONAL_PUBLIC_KEYS_JSON=
PARKIO_GATEWAY_INTERNAL_SECRET="REPLACE_ME_gateway_secret_min_32_chars"
PARKIO_GATEWAY_INTERNAL_ACCEPTED_SECRETS=
PARKIO_WAITLIST_HASH_SECRET="REPLACE_ME_waitlist_hmac_secret_min_32_chars"

# Transactional providers. Never put these values in client-visible variables.
PARKIO_EMAIL_PROVIDER=resend
PARKIO_RESEND_API_KEY="REPLACE_ME_resend_api_key"
PARKIO_EMAIL_FROM="Parkio <verify@parkio.dev>"
PARKIO_EMAIL_REPLY_TO=support@parkio.dev
PARKIO_EMAIL_VERIFICATION_LOG_TOKEN=false
PARKIO_PASSWORD_RESET_LOG_TOKEN=false
PARKIO_PUSH_DELIVERY_PROVIDER=expo
PARKIO_EXPO_ACCESS_TOKEN="REPLACE_ME_expo_access_token"

# Service-owned PostgreSQL databases and server-only credentials.
POSTGRES_AUTH_DB=parkio_auth
POSTGRES_AUTH_USER=parkio_auth
POSTGRES_AUTH_PASSWORD="REPLACE_ME_auth_db_password"
POSTGRES_GATEWAY_DB=parkio_gateway
POSTGRES_GATEWAY_USER=parkio_gateway
POSTGRES_GATEWAY_PASSWORD="REPLACE_ME_gateway_db_password"
POSTGRES_USER_DB=parkio_user
POSTGRES_USER_USER=parkio_user
POSTGRES_USER_PASSWORD="REPLACE_ME_user_db_password"
POSTGRES_PARKING_DB=parkio_parking
POSTGRES_PARKING_USER=parkio_parking
POSTGRES_PARKING_PASSWORD="REPLACE_ME_parking_db_password"
POSTGRES_MEDIA_DB=parkio_media
POSTGRES_MEDIA_USER=parkio_media
POSTGRES_MEDIA_PASSWORD="REPLACE_ME_media_db_password"
POSTGRES_GAMIFICATION_DB=parkio_gamification
POSTGRES_GAMIFICATION_USER=parkio_gamification
POSTGRES_GAMIFICATION_PASSWORD="REPLACE_ME_gamification_db_password"
POSTGRES_NOTIFICATION_DB=parkio_notification
POSTGRES_NOTIFICATION_USER=parkio_notification
POSTGRES_NOTIFICATION_PASSWORD="REPLACE_ME_notification_db_password"
POSTGRES_MODERATION_DB=parkio_moderation
POSTGRES_MODERATION_USER=parkio_moderation
POSTGRES_MODERATION_PASSWORD="REPLACE_ME_moderation_db_password"
POSTGRES_ANALYTICS_DB=parkio_analytics
POSTGRES_ANALYTICS_USER=parkio_analytics
POSTGRES_ANALYTICS_PASSWORD="REPLACE_ME_analytics_db_password"
POSTGRES_AIVALIDATION_DB=parkio_aivalidation
POSTGRES_AIVALIDATION_USER=parkio_aivalidation
POSTGRES_AIVALIDATION_PASSWORD="REPLACE_ME_ai_validation_db_password"

# Private data-plane credentials and bounds.
REDIS_PASSWORD="REPLACE_ME_redis_password"
KAFKA_CLUSTER_ID="REPLACE_ME_kafka_cluster_id"
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=2147483648
KAFKA_LOG_SEGMENT_BYTES=268435456
MINIO_ROOT_USER=parkio
MINIO_ROOT_PASSWORD="REPLACE_ME_minio_password"
MINIO_BUCKET=parkio-media
PARKIO_MEDIA_SCANNER_ENABLED=true
PARKIO_MEDIA_SCANNER_HOST=clamav
PARKIO_MEDIA_SCANNER_PORT=3310
PARKIO_MEDIA_SCANNER_CONNECT_TIMEOUT=2s
PARKIO_MEDIA_SCANNER_READ_TIMEOUT=10s

# Constrained Azure observability. The overlay also forces tracing off in every JVM.
PARKIO_ENVIRONMENT=hosted-beta
PARKIO_TRACING_ENABLED=false
PARKIO_TRACING_SAMPLING_PROBABILITY=0.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD="REPLACE_ME_grafana_password"
NODE_EXPORTER_PORT=9100
BLACKBOX_EXPORTER_PORT=9115
KAFKA_EXPORTER_PORT=9308
PARKIO_ALERT_SLACK_WEBHOOK_URL=
PARKIO_ALERT_WEBHOOK_URL=

# Hosted safety toggles.
PARKIO_OPENAPI_ENABLED=false
PARKIO_SMART_RETURN_ENABLED=true
PARKIO_SMART_RETURN_SCHEDULER_ENABLED=true
PARKIO_SMART_RETURN_TEST_HOOKS_ENABLED=false

# Portable encrypted backup staging. Copy every successful set off the VM.
BACKUP_DIR=/var/backups/parkio
BACKUP_ENCRYPT_PASSPHRASE="REPLACE_ME_backup_encryption_passphrase"
BACKUP_MC_DEST=
BACKUP_RETENTION_DAYS=14

# One-time SUPER_ADMIN bootstrap (auth-service). Keep disabled once the first
# admin exists; set both only for the single bootstrap run, then unset them.
# See docs/operations/ADMIN-PANEL.md and scripts/bootstrap-super-admin.sh
PARKIO_ADMIN_BOOTSTRAP_ENABLED=false
PARKIO_ADMIN_BOOTSTRAP_TOKEN=

# --------------------------------------------------------------------------- #
# Parking session stale lifecycle (parking-service)                             #
# Defaults match production-safe 24h / 48h / 72h. Retention OFF by default.   #
# --------------------------------------------------------------------------- #
PARKIO_PARKING_SESSION_STALE_ENABLED=true
PARKIO_PARKING_SESSION_CONFIRM_AFTER=PT24H
PARKIO_PARKING_SESSION_REMINDER_2_AFTER=PT48H
PARKIO_PARKING_SESSION_AUTO_COMPLETE_AFTER=PT72H
PARKIO_PARKING_SESSION_SCHEDULER_RATE=PT1H
# Live job delay (ms). Must match SCHEDULER_RATE (PT1H = 3600000).
PARKIO_PARKING_SESSION_STALE_FIXED_DELAY_MS=3600000
PARKIO_PARKING_SESSION_SCHEDULER_BATCH_SIZE=100
PARKIO_PARKING_SESSION_REMINDERS_ENABLED=true
PARKIO_PARKING_SESSION_AUTO_COMPLETE_ENABLED=true
PARKIO_PARKING_SESSION_NOTIFICATION_ENABLED=true
PARKIO_PARKING_SESSION_RETENTION_ENABLED=false
PARKIO_PARKING_SESSION_RETENTION_AFTER=P365D

# PROVIDER-ISTANBUL-01 / 01A: İstanbul / İSPARK (parking-service).
# Compose passthrough is required (docker-compose.azure-hosted-beta.yml). Defaults stay
# false so a clean deploy is dark; set both true only on hosted-beta when enabling İSPARK.
# Base URL/path stay application defaults (https://api.ibb.gov.tr + /ispark/Park).
PARKIO_MUNICIPAL_ISPARK_ENABLED=false
PARKIO_MUNICIPAL_ISPARK_SCHEDULER_ENABLED=false
PARKIO_MUNICIPAL_ISPARK_FIXED_DELAY_MS=120000
# Optional HTTP tuning (application defaults shown):
# PARKIO_MUNICIPAL_ISPARK_CONNECT_TIMEOUT=2s
# PARKIO_MUNICIPAL_ISPARK_READ_TIMEOUT=10s
# PARKIO_MUNICIPAL_ISPARK_MAX_RETRIES=1

# PROVIDER-ISTANBUL-01C: Smart Parking Recommendations + Ranking (parking-service runtime).
# Compose passthrough is required (docker-compose.azure-hosted-beta.yml). Defaults stay false.
# Enabling Recommendations/Ranking is a parking-service recreate (no web rebuild).
# Ranking weights remain application.yml defaults — do not override here unless ops needs it.
PARKIO_SPA_RECOMMENDATIONS_ENABLED=false
PARKIO_SPA_RANKING_ENABLED=false
# WP-SPA-14: AI ranking shadow FRAMEWORK (local challenger only; never mutates public order).
# Defaults stay false / 0.0. Enabling shadow is a parking-service recreate (no web rebuild).
PARKIO_SPA_RANKING_SHADOW_ENABLED=false
PARKIO_SPA_RANKING_SHADOW_SAMPLE_RATE=0.0
# WP-SPA-14B: privacy-safe ranking evaluation correlation (opaque evaluationId + outcomes).
# Defaults stay false. Enabling is a parking-service recreate (no web rebuild required for backend mint).
PARKIO_SPA_RANKING_EVALUATION_ENABLED=false
PARKIO_SPA_RANKING_EVALUATION_RETENTION_HOURS=24
PARKIO_SPA_RANKING_EVALUATION_ROLLUP_ENABLED=false
PARKIO_SPA_RANKING_EVALUATION_ROLLUP_RETENTION_DAYS=90

# DATA-WP-11: public municipal provenance on nearby/detail (canonical default true).
# Production must keep this false until a separate rollout approval.
# DATA-WP-11A leave-on gate is separate and not started by the implementation package.
PARKIO_MUNICIPAL_REGISTRY_PROVENANCE_PUBLICATION_ENABLED=true
# DATA-WP-12: nearby duplicate-presentation (canonical/hosted-beta default true).
# Production must keep this false until a separate rollout approval.
# DATA-WP-12A leave-on gate is separate and not started by the implementation package.
PARKIO_MUNICIPAL_DISCOVERY_DUPLICATE_PRESENTATION_ENABLED=true
# DATA-WP-15: read-only admin municipal quality/coverage report (canonical default false).
# Keep false everywhere until DATA-WP-15A; enabling only registers a read-only ADMIN endpoint.
PARKIO_MUNICIPAL_OPS_QUALITY_REPORT_ENABLED=false
# DATA-WP-16: source-mode-aware SLA (leave-on is DATA-WP-16A; keep false until gate).
PARKIO_MUNICIPAL_OPS_SOURCE_MODE_SLA_ENABLED=false
# DATA-WP-18: district coverage section (leave-on is DATA-WP-18A; keep false until gate).
PARKIO_MUNICIPAL_OPS_DISTRICT_COVERAGE_ENABLED=false
# PARKIO_MUNICIPAL_OPS_DISTRICT_COVERAGE_ASSET_PATH=/opt/parkio/ops/data-wp-08/boundary/izmir-ilceler-source.geojson
# PARKIO_MUNICIPAL_OPS_DISTRICT_COVERAGE_EXPECTED_SHA256=6f4f43e4ce8139ddca4606582d903f047cb7c73810f8b876541a1ec3994ffd89
# Optional recent-run window bounds for the report (defaults shown).
# PARKIO_MUNICIPAL_OPS_QUALITY_REPORT_RECENT_RUN_LIMIT_DEFAULT=20
# PARKIO_MUNICIPAL_OPS_QUALITY_REPORT_RECENT_RUN_LIMIT_MAX=100