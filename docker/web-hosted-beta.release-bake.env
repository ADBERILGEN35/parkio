# Canonical hosted-beta LIVE web bake profile (parkio-civo-prod / azure-hosted-beta).
# Source these values when rebuilding the production web image. Dockerfile ARG and
# compose `${VAR:-false}` defaults stay fail-closed; omitting these args recreates
# the P01F Explore regression (API base fixed, public Explore baked false) or a
# silent municipal-off recurrence.
#
# Matches the intended live pin in docker/docker-compose.web-release-pin.yml after
# the PR #69 municipal-on release. Both Public Explore and authenticated municipal
# discovery must stay enabled for hosted-beta live API builds.
#
# PROD-MUNI-01 still forbids municipal=true when VITE_APP_ENV=production.
# hosted-beta leave-on is allowed (WEB-MUNI-01A).

VITE_APP_ENV=hosted-beta
VITE_API_BASE_URL=https://api.parkio.dev/api/v1
VITE_PUBLIC_EXPLORE_ENABLED=true
VITE_WEB_MUNICIPAL_DISCOVERY_ENABLED=true
VITE_SMART_PARKING_ASSISTANT_ENABLED=false
VITE_SMART_RETURN_ENABLED=true
VITE_WAITLIST_INTAKE_MODE=api
VITE_MAPTILER_STYLE=streets-v2
VITE_FRONTEND_ERROR_REPORTING=disabled

# Server layers must stay ON for anonymous Explore (independent of Vite bake).
PARKIO_PUBLIC_EXPLORE_ENABLED=true
PARKIO_PUBLIC_EXPLORE_ALLOWED_SOURCE_FAMILIES=izum
