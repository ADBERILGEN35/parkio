# Prepared hosted-beta web bake for authenticated /map municipal discovery.
# NOT the live pin. Do not deploy without a separate reviewed release.
#
# Enabling VITE_WEB_MUNICIPAL_DISCOVERY_ENABLED alone is insufficient:
# 1. Rebuild web with this profile (build-time Vite flags).
# 2. verify-bundle-env --app-env hosted-beta --require-public-explore true --require-municipal true
# 3. Confirm /map remains auth-protected; /facilities/:id stays protected.
# 4. Accept community parking, session actions, filters, attribution, freshness.
# 5. Confirm anonymous /explore + PA-06 (communitySpotCountInScope null) unchanged.
# 6. Publish digest, update docker-compose.web-release-pin.yml, recreate web only.
#
# PROD-MUNI-01 still forbids municipal=true when VITE_APP_ENV=production.
# hosted-beta leave-on is allowed (WEB-MUNI-01A).

VITE_APP_ENV=hosted-beta
VITE_API_BASE_URL=https://api.parkio.dev/api/v1
VITE_PUBLIC_EXPLORE_ENABLED=true
VITE_WEB_MUNICIPAL_DISCOVERY_ENABLED=true
VITE_SMART_PARKING_ASSISTANT_ENABLED=false
VITE_SMART_RETURN_ENABLED=true
VITE_WAITLIST_INTAKE_MODE=api
VITE_MAPTILER_STYLE=streets-v2
VITE_FRONTEND_ERROR_REPORTING=disabled

PARKIO_PUBLIC_EXPLORE_ENABLED=true
PARKIO_PUBLIC_EXPLORE_ALLOWED_SOURCE_FAMILIES=izum
