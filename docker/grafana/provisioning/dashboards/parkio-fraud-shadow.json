{
  "uid": "parkio-fraud-shadow",
  "title": "Parkio Fraud Shadow",
  "tags": ["parkio", "fraud", "shadow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Evaluation Success Rate (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "parkio-prometheus" },
      "targets": [{ "expr": "parkio:fraud_shadow:success_rate5m", "legendFormat": "success" }]
    },
    {
      "id": 2,
      "title": "Duplicate Rate (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "parkio-prometheus" },
      "targets": [{ "expr": "parkio:fraud_shadow:duplicate_rate5m", "legendFormat": "duplicate" }]
    },
    {
      "id": 3,
      "title": "Failure Rate (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "parkio-prometheus" },
      "targets": [{ "expr": "parkio:fraud_shadow:failure_rate5m", "legendFormat": "failure" }]
    },
    {
      "id": 4,
      "title": "Replay Mismatch Rate (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "parkio-prometheus" },
      "targets": [{ "expr": "parkio:fraud_shadow:replay_mismatch_rate5m", "legendFormat": "mismatch" }]
    },
    {
      "id": 5,
      "title": "Disposition Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "parkio-prometheus" },
      "targets": [
        {
          "expr": "sum by (disposition) (rate(parkio_parking_fraud_evaluation_success_total[5m]))",
          "legendFormat": "{{disposition}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Risk Band Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "parkio-prometheus" },
      "targets": [
        {
          "expr": "sum by (risk_band) (rate(parkio_parking_fraud_evaluation_success_total[5m]))",
          "legendFormat": "{{risk_band}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Evaluation Duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "parkio-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(parkio_parking_fraud_evaluation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
