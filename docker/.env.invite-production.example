# Parkio controlled-invite production foundation template.
# Copy to docker/.env.invite-production, replace every REPLACE_ME value, and keep
# the real file out of Git. This package intentionally reuses the canonical
# parkio.dev hostnames for first production invite.

PARKIO_DEPLOYMENT_PROFILE=invite-production
PARKIO_ENVIRONMENT=invite-production

# Public, client-visible hosts and build configuration.
PARKIO_DOMAIN=api.parkio.dev
PARKIO_WEB_DOMAIN=app.parkio.dev
PARKIO_WEB_UPSTREAM=web:80
PARKIO_MEDIA_DOMAIN=media.parkio.dev
PARKIO_MEDIA_STORAGE_ENDPOINT=http://minio:9000
PARKIO_MEDIA_STORAGE_PUBLIC_ENDPOINT=https://media.parkio.dev
PARKIO_ACME_EMAIL="REPLACE_ME_ops_email"
PARKIO_CORS_ALLOWED_ORIGINS=https://app.parkio.dev
PARKIO_CORS_ALLOW_CREDENTIALS=true
PARKIO_WEB_BASE_URL=https://app.parkio.dev
VITE_API_BASE_URL=https://api.parkio.dev/api/v1
VITE_APP_ENV=invite-production
VITE_WAITLIST_INTAKE_MODE=api
VITE_SMART_RETURN_ENABLED=true
VITE_WEB_MUNICIPAL_DISCOVERY_ENABLED=true
VITE_SMART_PARKING_ASSISTANT_ENABLED=true
VITE_FRONTEND_ERROR_REPORTING=disabled
VITE_MAPTILER_KEY="REPLACE_ME_maptiler_public_key"
VITE_MAPTILER_STYLE=streets-v2

# Managed PostgreSQL: one private Flexible Server, ten logical DBs, hostname only.
PARKIO_PG_MODE=managed
PARKIO_PG_HOST="REPLACE_ME_invite_pg_fqdn"
PARKIO_PG_PORT=5432
PARKIO_PG_SSLMODE=verify-full
PARKIO_PG_SSLROOTCERT=/opt/parkio/certs/azure-postgres-root.crt
PARKIO_PG_SSLROOTCERT_HOST=/opt/parkio/certs/azure-postgres-root.crt
PARKIO_PG_JDBC_QUERY=sslmode=verify-full&sslrootcert=/opt/parkio/certs/azure-postgres-root.crt
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=4
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# Server-only authentication and gateway trust.
PARKIO_JWT_PRIVATE_KEY_PEM="REPLACE_ME_pkcs8_pem_with_newline_escapes"
PARKIO_JWT_KEY_ID=parkio-auth-rs256-invite-prod-1
PARKIO_JWT_ISSUER=parkio-auth
PARKIO_JWT_AUDIENCE=parkio-api
PARKIO_JWT_CLOCK_SKEW_SECONDS=30
PARKIO_JWT_ADDITIONAL_PUBLIC_KEYS_JSON=
PARKIO_GATEWAY_INTERNAL_SECRET="REPLACE_ME_gateway_secret_min_32_chars"
PARKIO_GATEWAY_INTERNAL_ACCEPTED_SECRETS=
PARKIO_WAITLIST_HASH_SECRET="REPLACE_ME_waitlist_hmac_secret_min_32_chars"

# Transactional providers.
PARKIO_EMAIL_PROVIDER=resend
PARKIO_RESEND_API_KEY="REPLACE_ME_resend_api_key"
PARKIO_EMAIL_FROM="Parkio <verify@parkio.dev>"
PARKIO_EMAIL_REPLY_TO=support@parkio.dev
PARKIO_EMAIL_VERIFICATION_LOG_TOKEN=false
PARKIO_PASSWORD_RESET_LOG_TOKEN=false
# Mobile delivery is outside the controlled-invite web boundary. Keep the
# worker disabled so the noop adapter can never mark pending attempts sent.
PARKIO_PUSH_DELIVERY_ENABLED=false
PARKIO_PUSH_DELIVERY_PROVIDER=noop
PARKIO_EXPO_ACCESS_TOKEN=

# Service-owned logical DBs and distinct runtime passwords.
POSTGRES_AUTH_DB=parkio_auth
POSTGRES_AUTH_USER=parkio_auth
POSTGRES_AUTH_PASSWORD="REPLACE_ME_auth_db_password"
POSTGRES_AUTH_MIGRATION_USER=parkio_auth_migrator
POSTGRES_AUTH_MIGRATION_PASSWORD="REPLACE_ME_auth_migration_db_password"
POSTGRES_GATEWAY_DB=parkio_gateway
POSTGRES_GATEWAY_USER=parkio_gateway
POSTGRES_GATEWAY_PASSWORD="REPLACE_ME_gateway_db_password"
POSTGRES_GATEWAY_MIGRATION_USER=parkio_gateway_migrator
POSTGRES_GATEWAY_MIGRATION_PASSWORD="REPLACE_ME_gateway_migration_db_password"
POSTGRES_USER_DB=parkio_user
POSTGRES_USER_USER=parkio_user
POSTGRES_USER_PASSWORD="REPLACE_ME_user_db_password"
POSTGRES_USER_MIGRATION_USER=parkio_user_migrator
POSTGRES_USER_MIGRATION_PASSWORD="REPLACE_ME_user_migration_db_password"
POSTGRES_PARKING_DB=parkio_parking
POSTGRES_PARKING_USER=parkio_parking
POSTGRES_PARKING_PASSWORD="REPLACE_ME_parking_db_password"
POSTGRES_PARKING_MIGRATION_USER=parkio_parking_migrator
POSTGRES_PARKING_MIGRATION_PASSWORD="REPLACE_ME_parking_migration_db_password"
POSTGRES_MEDIA_DB=parkio_media
POSTGRES_MEDIA_USER=parkio_media
POSTGRES_MEDIA_PASSWORD="REPLACE_ME_media_db_password"
POSTGRES_MEDIA_MIGRATION_USER=parkio_media_migrator
POSTGRES_MEDIA_MIGRATION_PASSWORD="REPLACE_ME_media_migration_db_password"
POSTGRES_GAMIFICATION_DB=parkio_gamification
POSTGRES_GAMIFICATION_USER=parkio_gamification
POSTGRES_GAMIFICATION_PASSWORD="REPLACE_ME_gamification_db_password"
POSTGRES_GAMIFICATION_MIGRATION_USER=parkio_gamification_migrator
POSTGRES_GAMIFICATION_MIGRATION_PASSWORD="REPLACE_ME_gamification_migration_db_password"
POSTGRES_NOTIFICATION_DB=parkio_notification
POSTGRES_NOTIFICATION_USER=parkio_notification
POSTGRES_NOTIFICATION_PASSWORD="REPLACE_ME_notification_db_password"
POSTGRES_NOTIFICATION_MIGRATION_USER=parkio_notification_migrator
POSTGRES_NOTIFICATION_MIGRATION_PASSWORD="REPLACE_ME_notification_migration_db_password"
POSTGRES_MODERATION_DB=parkio_moderation
POSTGRES_MODERATION_USER=parkio_moderation
POSTGRES_MODERATION_PASSWORD="REPLACE_ME_moderation_db_password"
POSTGRES_MODERATION_MIGRATION_USER=parkio_moderation_migrator
POSTGRES_MODERATION_MIGRATION_PASSWORD="REPLACE_ME_moderation_migration_db_password"
POSTGRES_ANALYTICS_DB=parkio_analytics
POSTGRES_ANALYTICS_USER=parkio_analytics
POSTGRES_ANALYTICS_PASSWORD="REPLACE_ME_analytics_db_password"
POSTGRES_ANALYTICS_MIGRATION_USER=parkio_analytics_migrator
POSTGRES_ANALYTICS_MIGRATION_PASSWORD="REPLACE_ME_analytics_migration_db_password"
POSTGRES_AIVALIDATION_DB=parkio_aivalidation
POSTGRES_AIVALIDATION_USER=parkio_aivalidation
POSTGRES_AIVALIDATION_PASSWORD="REPLACE_ME_ai_validation_db_password"
POSTGRES_AIVALIDATION_MIGRATION_USER=parkio_aivalidation_migrator
POSTGRES_AIVALIDATION_MIGRATION_PASSWORD="REPLACE_ME_ai_validation_migration_db_password"

# Private data plane credentials.
REDIS_PASSWORD="REPLACE_ME_redis_password"
KAFKA_CLUSTER_ID="REPLACE_ME_kafka_cluster_id"
MINIO_ROOT_USER=parkio
MINIO_ROOT_PASSWORD="REPLACE_ME_minio_password"
MINIO_BUCKET=parkio-media
PARKIO_MEDIA_SCANNER_ENABLED=true
PARKIO_MEDIA_SCANNER_HOST=clamav
PARKIO_MEDIA_SCANNER_PORT=3310

# Observability and paging must stay on in invite production.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD="REPLACE_ME_grafana_password"
NODE_EXPORTER_PORT=9100
BLACKBOX_EXPORTER_PORT=9115
KAFKA_EXPORTER_PORT=9308
PARKIO_ALERT_SLACK_WEBHOOK_URL="REPLACE_ME_slack_webhook"
PARKIO_ALERT_WEBHOOK_URL=

# Backup must fail closed and upload offsite.
BACKUP_DIR=/var/backups/parkio
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSITE_RETENTION_DAYS=14
BACKUP_PRODUCTION_MODE=1
BACKUP_ENCRYPT_PASSPHRASE="REPLACE_ME_backup_encryption_passphrase"
BACKUP_OFFSITE_KIND=azure
BACKUP_AZURE_STORAGE_ACCOUNT="REPLACE_ME_invite_backup_storage_account"
BACKUP_AZURE_CONTAINER=invite-production-backups
BACKUP_MC_DEST=

# Safety and privacy toggles.
PARKIO_OPENAPI_ENABLED=false
PARKIO_ACCOUNT_ERASURE_ENABLED=true
PARKIO_ACCOUNT_ERASURE_PARTICIPANTS=user,parking,media,moderation,gamification,notification,analytics,ai-validation
PARKIO_SMART_RETURN_ENABLED=true
PARKIO_SMART_RETURN_SCHEDULER_ENABLED=true
PARKIO_SMART_RETURN_TEST_HOOKS_ENABLED=false

# Controlled-invite feature policy.
PARKIO_MUNICIPAL_ENABLED=true
PARKIO_MUNICIPAL_MANUAL_SYNC_ENABLED=false
PARKIO_MUNICIPAL_DISCOVERY_DUPLICATE_PRESENTATION_ENABLED=true
PARKIO_MUNICIPAL_IZUM_ENABLED=true
PARKIO_MUNICIPAL_IZUM_SCHEDULER_ENABLED=true
PARKIO_MUNICIPAL_ISPARK_ENABLED=true
PARKIO_MUNICIPAL_ISPARK_SCHEDULER_ENABLED=true
PARKIO_MUNICIPAL_ANPARK_ENABLED=false
PARKIO_MUNICIPAL_ANPARK_SCHEDULER_ENABLED=false
PARKIO_MUNICIPAL_KONYA_ENABLED=false
PARKIO_MUNICIPAL_KONYA_SCHEDULER_ENABLED=false
PARKIO_MUNICIPAL_KAYSERI_ENABLED=false
PARKIO_MUNICIPAL_KAYSERI_SCHEDULER_ENABLED=false
PARKIO_MUNICIPAL_OSM_IMPORT_ENABLED=false
PARKIO_MUNICIPAL_OSM_SCHEDULER_ENABLED=false
PARKIO_MUNICIPAL_OSM_PUBLICATION_ENABLED=false
PARKIO_SPA_RECOMMENDATIONS_ENABLED=true
PARKIO_SPA_RANKING_ENABLED=true
PARKIO_SPA_RANKING_STRATEGY=DETERMINISTIC_V1
PARKIO_SPA_RANKING_SHADOW_ENABLED=false
PARKIO_SPA_RANKING_SHADOW_SAMPLE_RATE=0.0
PARKIO_SPA_RANKING_EVALUATION_ENABLED=false
PARKIO_SPA_RANKING_EVALUATION_ROLLUP_ENABLED=false
