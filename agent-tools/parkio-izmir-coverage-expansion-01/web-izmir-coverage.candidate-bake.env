# Candidate hosted-beta web bake for İzmir coverage expansion (PR #71).
# Extends docker/web-hosted-beta.release-bake.env with UX-bearing municipal/Explore ON.
# Server Explore families widen only at publish flip — bake documents the intended pairing.
#
# PROD-MUNI-01: VITE_APP_ENV must remain hosted-beta (not production) while municipal=true.

VITE_APP_ENV=hosted-beta
VITE_API_BASE_URL=https://api.parkio.dev/api/v1
VITE_PUBLIC_EXPLORE_ENABLED=true
VITE_WEB_MUNICIPAL_DISCOVERY_ENABLED=true
VITE_SMART_PARKING_ASSISTANT_ENABLED=false
VITE_SMART_RETURN_ENABLED=true
VITE_WAITLIST_INTAKE_MODE=api
VITE_MAPTILER_STYLE=streets-v2
VITE_FRONTEND_ERROR_REPORTING=disabled
VERIFY_REQUIRE_PUBLIC_EXPLORE=true
VERIFY_REQUIRE_MUNICIPAL=true

# Server-side (compose/env on parking) — flip only after import+publication approval.
PARKIO_PUBLIC_EXPLORE_ENABLED=true
PARKIO_PUBLIC_EXPLORE_ALLOWED_SOURCE_FAMILIES=IZUM,IZELMAN,OSM
