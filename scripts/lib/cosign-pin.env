# Pinned cosign for host preflight and operator install (B-02 / #461).
# Installer action pin (GitHub Actions): sigstore/cosign-installer@398d4b0eeef1380460a10c8013a76f728fb906ac
PARKIO_COSIGN_VERSION=v2.5.3
PARKIO_COSIGN_INSTALLER_ACTION=sigstore/cosign-installer@398d4b0eeef1380460a10c8013a76f728fb906ac
# Independently recorded asset digests from the upstream release checksums file for PARKIO_COSIGN_VERSION
# (https://github.com/sigstore/cosign/releases/download/v2.5.3/cosign_checksums.txt).
PARKIO_COSIGN_CHECKSUMS_URL=https://github.com/sigstore/cosign/releases/download/v2.5.3/cosign_checksums.txt
PARKIO_COSIGN_SHA256_LINUX_AMD64=783b5d6c74105401c63946c68d9b2a4e1aab3c8abce043e06b8510b02b623ec9
PARKIO_COSIGN_SHA256_LINUX_ARM64=bffabe4cf183122b7de3111257a863c99e7dc6cf1093bfd7bf961de1795589b8
PARKIO_PROVENANCE_OIDC_ISSUER=https://token.actions.githubusercontent.com
# The one publisher identity (G-07, #489): candidate-publish.yml running on refs/heads/api. The publish-time
# verify (candidate-publish.yml) and the deploy gate (scripts/lib/deploy-image-provenance.sh) both read it
# from here. Anchored with dots escaped; single quotes keep the backslashes and `$` for sh and bash.
PARKIO_PROVENANCE_IDENTITY_REGEXP='^https://github\.com/ADBERILGEN35/parkio/\.github/workflows/candidate-publish\.yml@refs/heads/api$'
PARKIO_PROVENANCE_PREDICATE_TYPE=https://slsa.dev/provenance/v1
