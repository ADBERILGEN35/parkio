# /etc/parkio/slack-biz.conf.env  (0644 root:root) — NON-secret relay settings.
# Keep delivery disabled until the owner explicitly authorises activation.
PARKIO_SLACK_BIZ_ENABLED=false
# Must equal the gateway's PARKIO_ENVIRONMENT or envelopes are rejected.
PARKIO_SLACK_BIZ_ENVIRONMENT=production
PARKIO_SLACK_BIZ_DATA_DIR=/var/lib/parkio/slack-biz
PARKIO_SLACK_BIZ_WAITLIST_INBOX=/var/lib/parkio/waitlist-ops-inbox
PARKIO_SLACK_BIZ_MAX_ATTEMPTS=5
PARKIO_SLACK_BIZ_HTTP_TIMEOUT=5
PARKIO_SLACK_BIZ_DEDUP_RETENTION_HOURS=168
PARKIO_SLACK_BIZ_DLT_RETENTION_HOURS=720
PARKIO_SLACK_BIZ_WAITLIST_ACKED_RETENTION_HOURS=24
PARKIO_SLACK_BIZ_WAITLIST_RETAIN_REJECTED=false
PARKIO_SLACK_BIZ_WAITLIST_REJECTED_RETENTION_HOURS=72
PARKIO_SLACK_BIZ_FORBID_ALERTMANAGER_WEBHOOK=1
# Isolation: this host package serves ONLY gateway waitlist confirmations.
# Any other producer (incl. the legacy registration / Kafka paths) is rejected.
PARKIO_SLACK_BIZ_TRUSTED_PRODUCERS=gateway-waitlist-outbox
# Backpressure (files stay in the inbox; nothing is deleted)
PARKIO_SLACK_BIZ_MAX_PENDING=5000
PARKIO_SLACK_BIZ_MIN_FREE_MB=256
# Must stay unset on this host (registration consumer is out of scope and OFF):
#   PARKIO_SLACK_BIZ_REGISTRATION_INBOX, PARKIO_SLACK_BIZ_KAFKA_BOOTSTRAP
