# /etc/parkio/slack-biz.secret.env  (0600 root:root) — SECRET. Never commit,
# never paste into chat/tickets, never pass on a command line.
# Write it with: sudo install -m 600 -o root -g root /dev/null /etc/parkio/slack-biz.secret.env
#                sudoedit /etc/parkio/slack-biz.secret.env
# Only the worker unit loads this file; the consumer and the gateway never see it.
PARKIO_SLACK_BIZ_WEBHOOK_URL_BIZ=
# Set to the Alertmanager webhook ONLY so the worker can refuse an identical
# value (ownership guard). Leave empty if not available on this host.
PARKIO_ALERT_SLACK_WEBHOOK_URL=
