# Parkio slack_biz — delivery worker (Civo host). The only process that holds
# the Slack webhook secret. Single worker is enforced by an SQLite lock.
# Do NOT also run the docker-compose.slack-biz.yml worker on the same host.
[Unit]
Description=Parkio slack_biz delivery worker
Documentation=file:///opt/parkio/docs/operations/waitlist-slack-notifications.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parkio-slackbiz
Group=parkio-slackbiz
UMask=0077
# Non-secret settings first, then the root-only secret file (0600 root:root,
# read by systemd before privileges are dropped; never readable by the user).
EnvironmentFile=/etc/parkio/slack-biz.conf.env
EnvironmentFile=/etc/parkio/slack-biz.secret.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/parkio/scripts/slack_biz/worker.py --loop --interval 2 --worker-id civo-worker-1
Restart=on-failure
RestartSec=10s

# Least privilege
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/parkio/slack-biz
ReadOnlyPaths=/opt/parkio/scripts/slack_biz
InaccessiblePaths=/var/lib/parkio/waitlist-ops-inbox
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
