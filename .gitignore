# Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/

# Build output
out/
bin/

# IDE - IntelliJ
.idea/
*.iml
*.ipr
*.iws

# IDE - Eclipse
.classpath
.project
.settings/

# IDE - VS Code
.vscode/

# Java
*.class
*.log
hs_err_pid*

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example
# Committable env TEMPLATES only (no secrets): .env.example and .env.<variant>.example
# (e.g. docker/.env.hosted-beta.example). Real .env / .env.<env> files stay ignored above.
!.env.*.example
*.local

# Docker
docker/data/

# --------------------------------------------------------------------------- #
# AI coding-tool local files — NEVER commit.                                  #
# These are per-developer tool memory/config, not project artifacts. Canonical #
# project documentation lives under /docs and /docs/ai-context (see README).   #
# A bare filename pattern matches at any depth.                               #
# --------------------------------------------------------------------------- #

# Claude Code / claude-mem (auto-generated memory & local config)
CLAUDE.md
.claude/
.claude-mem/

# Cursor
.cursor/
.cursor-rules/
.cursorrules
.cursorignore

# Database backups (never commit dumps; scripts/backup-databases.sh defaults to ./backups)
/backups/
backups/
*.sql.gz
*.sql.gz.enc

# Aider
.aider*

# OpenAI Codex / GPT / generic LLM & AI tool files
.codex*
.gpt*
.llm*
.ai*

# Note: /docs and /docs/ai-context stay versioned — none of the patterns above
# match them (they have no leading dot, and the only CLAUDE.md inside them is a
# tool-generated stub that SHOULD be ignored). Project docs are *.md files there.

# Deploy manifests (local/VPS); keep directory via .gitkeep
deploy-artifacts/*
!deploy-artifacts/.gitkeep

# PP-01B-SPIKE-03 Mode A transient TLS material (never commit)
**/.spike03-certs/
**/spike03-tls-work/

# PP-01B Terraform authoring artifacts (never commit state/plans/locks local)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfplan.*
**/crash.log
**/crash.*.log
infra/terraform/**/*.auto.tfvars
infra/terraform/**/terraform.tfvars
infra/evidence/

backup-artifacts/*
!backup-artifacts/.gitkeep

# Local operator tools (e.g. portable jq)
.tools/

# Prometheus textfile metrics (written by backup jobs)
docker/prometheus/textfile/*.prom
!docker/prometheus/textfile/.gitkeep

# Isolated alerting-acceptance receipts (no secrets; still local/CI only)
docker/.alerting-acceptance-receipts/


# Local pnpm cache
**/.pnpm-store/

# Python bytecode (local staging helpers)
**/__pycache__/
*.py[cod]

# WP-06.2 generated operational evidence (never commit live drill output)
build/operational-evidence/
artifacts/wp-06-2/

# Local mobile build artifacts
artifacts/*.apk
artifacts/*.aab
artifacts/*.sha256


# Local Android builds
frontend/apps/mobile-v2/android/.cxx/
frontend/apps/mobile-v2/android/.gradle/
frontend/apps/mobile-v2/android/build/

# Local Expo
.expo/

# Local IDE
.idea/workspace.xml
# Operator-generated DATA hosted-beta gate evidence
docs/evidence/data-wp-*/

# Operator-generated DATA hosted-beta gate evidence
docs/evidence/data-wp-*/

# Temporary hosted-beta gate scripts
scripts/staging/_wp*a_*.sh
